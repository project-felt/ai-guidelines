#!/bin/bash
# Checks that staged content/*.md files have an updated revision and changelog entry.

error=0

while IFS= read -r file; do
  if [[ "$file" =~ ^content/.*\.md$ ]] && [[ -f "$file" ]]; then
    # Check if the revision field was changed in this commit
    revision_diff=$(git diff --cached -U0 "$file" | grep -E '^\+revision:')
    if [ -z "$revision_diff" ]; then
      current_rev=$(grep '^revision:' "$file" | head -1 | awk '{print $2}')
      echo "⚠  $file has changes but revision was not updated."
      echo "   Current revision: ${current_rev:-unknown}"
      echo "   Please bump the revision and add a changelog entry before committing."
      echo ""
      error=1
    fi
  fi
done < <(git diff --cached --name-only)

if [ $error -ne 0 ]; then
  echo "Commit aborted. Update revision and changelog in the files listed above."
  exit 1
fi

exit 0
